{
  "name": "flowpos-pro",
  "version": "1.0.0",
  "description": "PosFlow - نظام إدارة المبيعات والمخزون",
  "main": "main.js",
  "author": "FlowPOS Team",
  "license": "MIT",
  "build": {
    "appId": "app.flowpos.pro",
    "productName": "PosFlow",
    "directories": {
      "output": "../electron-dist"
    },
    "compression": "maximum",
    "asar": true,
    "files": [
      "../dist/**/*",
      "main.js",
      "error.html"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../resources/icon.png",
      "artifactName": "FlowPOS-Pro-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PosFlow",
      "installerIcon": "../resources/icon.png",
      "uninstallerIcon": "../resources/icon.png",
      "installerHeaderIcon": "../resources/icon.png",
      "differentialPackage": false,
      "packElevate": false
    }
  }
}
